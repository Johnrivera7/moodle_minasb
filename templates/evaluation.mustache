{{!
    @template mod_minaslab/evaluation

    Evaluación práctica semestral: cabecera curricular y contenedor de la app 3D (mod_minaslab/eval_app).

    Example context (json):
    {
        "semester": 4, "semesterroman": "IV",
        "subject": "Sistema de Explotación a Rajo Abierto",
        "support": "Ventilación de Minas · Diseño y Evaluación de Proyectos",
        "title": "Evaluación práctica IV", "summary": "Resumen",
        "competencies": [{"code": "C1", "desc": "Dirigir procesos"}],
        "ras": [{"code": "RAJ-RA1", "desc": "Identifica las fases"}],
        "canreport": true, "canattempt": true, "ispreview": false, "resultsurl": "#", "uijson": "{}"
    }
}}
<script type="application/json" id="mlx-ui">{{{uijson}}}</script>
<section class="mlx-head" aria-labelledby="mlx-title">
    <div class="mlx-head__band">
        <div class="mlx-head__sem" aria-hidden="true">
            <span class="mlx-head__sem-k">{{#str}}evui_semester, mod_minaslab{{/str}}</span>
            <span class="mlx-head__sem-n">{{semesterroman}}</span>
        </div>
        <div class="mlx-head__txt">
            <p class="mlx-head__kicker">{{subject}}{{#support}} · <span class="mlx-head__support">{{support}}</span>{{/support}}</p>
            <h3 class="mlx-head__title" id="mlx-title">{{title}}</h3>
            <p class="mlx-head__summary">{{summary}}</p>
        </div>
        {{#canreport}}
        <a class="btn btn-outline-light mlx-head__results" href="{{resultsurl}}">
            {{#pix}}i/report, core{{/pix}} {{#str}}results_title, mod_minaslab{{/str}}
        </a>
        {{/canreport}}
    </div>
    <details class="mlx-head__curr">
        <summary>{{#str}}evui_curriculum, mod_minaslab{{/str}}</summary>
        <div class="mlx-head__grid">
            <div>
                <h4>{{#str}}evui_ra, mod_minaslab{{/str}}</h4>
                <ul class="mlx-list">
                    {{#ras}}<li><span class="mlx-code">{{code}}</span> {{desc}}</li>{{/ras}}
                </ul>
            </div>
            <div>
                <h4>{{#str}}evui_competencies, mod_minaslab{{/str}}</h4>
                <ul class="mlx-list">
                    {{#competencies}}<li><span class="mlx-code mlx-code--c">{{code}}</span> {{desc}}</li>{{/competencies}}
                </ul>
            </div>
        </div>
    </details>
</section>
{{#ispreview}}
<div class="alert alert-info mlx-preview">{{#str}}evui_previewmode, mod_minaslab{{/str}}</div>
{{/ispreview}}
{{^canattempt}}
<div class="alert alert-warning mlx-preview">{{#str}}evui_noattempt, mod_minaslab{{/str}}</div>
{{/canattempt}}
<div class="mlx" id="mlx-app" data-canattempt="{{#canattempt}}1{{/canattempt}}{{^canattempt}}0{{/canattempt}}">
    <div class="mlx-boot" role="status">
        <div class="mlx-boot__spinner" aria-hidden="true"></div>
        <p>{{#str}}evui_loading, mod_minaslab{{/str}}</p>
    </div>
</div>
